// This source code is subject to the terms of the Mozilla Public License 2.0
// © Ilai - Asset Divergence Detector (PCP / PSP) v4.3
// Pine Script V5
//
// v4.3:
//  - Settings are now in Hebrew. The option strings are compared in code, so
//    they and the comparisons were translated together.
//  - New padding input for the corner line and the panel: empty spacer rows
//    lift the content off the chart edge, so it no longer collides with
//    another indicator's line sitting in the same corner.
//
// v4.2.1:
//  - Fixed a syntax error: the position ternary wrapped onto a line indented
//    by 40 spaces, and Pine reads any multiple of four as the start of a block.
//  - Line and panel placement are two inputs each, height and side.
//
// v4.2:
//  - New Weekly category: same PCP/PSP principle, full three-asset treatment.
//  - New corner line showing which PSP breaks are LIVE right now on the higher
//    timeframes (1H / 4H / 1D / 1W), without drawing anything extra on the bars.
//      * Only timeframes ABOVE the chart's are shown. request.security on a
//        timeframe below the chart returns one sample per chart bar, which would
//        corrupt the carried state the "level taken" rule depends on.
//      * A break stays live until its level is taken OR a new swing replaces it
//        on that same timeframe — whichever comes first.
//      * Each record ends with the age of the swing in bars of its own timeframe,
//        so an old, no-longer-relevant break is obvious at a glance.
//  - Symbols are three input.symbol fields instead of a Standard/Micro switch.
//  - One alert covering every timeframe, fired on any change to the line.
//
// v4.1:
//  - YM only creates a divergence when it shows STRENGTH (up while ES and/or NQ
//    are down). ES vs NQ unchanged: any direction mismatch counts.
//  - Swing detected on EVERY included asset: solid ▲/▼ when the swing is on the
//    chart symbol, hollow △/▽ when it is on another asset only.
//  - Pending marker (•) while a PCP bar's swing verdict is not in yet.
//  - Markers moved from label.new to plotchar; removed the broken majority vote.

//@version=5
indicator("Asset Divergence | PCP & PSP v4", shorttitle="ADI v4",
     overlay       = true,
     max_bars_back = 5000)

// ══════════════════════════════════════════════════════════════
//  INPUTS
//  Hebrew labels. Every option string below is also compared in code —
//  translating one without the other silently breaks the setting.
// ══════════════════════════════════════════════════════════════

grp_mode   = "═══  זיהוי  ═══"
i_ignore_doji = input.bool(false, title="התעלם מדוג'י (סגירה = פתיחה)",
     tooltip="כבוי (ברירת מחדל): דוג'י נחשב כיוון שונה ויכול ליצור PCP.\nדלוק: דוג'י ניטרלי ולעולם לא יוצר PCP.",
     group=grp_mode)

grp_assets = "═══  נכסים  ═══"
i_sym_nq   = input.symbol("NQ1!", title="סימבול NQ", group=grp_assets,
     tooltip="למעבר למיקרו — החלף את שלושת השדות ל-MNQ1! / MES1! / MYM1!\nחשוב לשמור על שלושתם מאותה משפחת חוזים; ערבוב גדלי טיק מעוות את ההשוואה.")
i_sym_es   = input.symbol("ES1!", title="סימבול ES", group=grp_assets)
i_sym_ym   = input.symbol("YM1!", title="סימבול YM", group=grp_assets)
i_use_nq   = input.bool(true,  title="כלול NQ", group=grp_assets)
i_use_es   = input.bool(true,  title="כלול ES", group=grp_assets)
i_use_ym   = input.bool(true,  title="כלול YM (חוזקה בלבד)",
     tooltip="YM יוצר דיברגנס רק כשהוא נסגר בעלייה בזמן ש-ES ו/או NQ נסגרים בירידה.",
     group=grp_assets)

grp_tf     = "═══  מסגרת הגרף  ═══"
i_tf_1m    = input.bool(true,  title="1m (ES ו-NQ בלבד)", group=grp_tf)
i_tf_5m    = input.bool(true,  title="5m",     group=grp_tf)
i_tf_15m   = input.bool(true,  title="15m",    group=grp_tf)
i_tf_1h    = input.bool(true,  title="1H",     group=grp_tf)
i_tf_4h    = input.bool(true,  title="4H",     group=grp_tf)
i_tf_1d    = input.bool(true,  title="יומי",   group=grp_tf)
i_tf_1w    = input.bool(true,  title="שבועי",  group=grp_tf)

grp_col    = "═══  סימונים וצבעים  ═══"
i_col_bull = input.color(color.new(#00e5ff, 0), title="אות שורי", group=grp_col)
i_col_bear = input.color(color.new(#ff1744, 0), title="אות דובי", group=grp_col)
i_ext_transp = input.int(45, title="עמעום סימון של נכס אחר", minval=0, maxval=90,
     tooltip="שקיפות הסימון החלול, שמצויר כשהסווינג קרה בנכס אחר ולא בסימבול שעל הגרף.",
     group=grp_col)
i_show_pending = input.bool(true, title="הצג סימון PCP ממתין (•)",
     tooltip="נר PCP מוכרע רק כשהנר שאחריו נסגר. עד אז הוא מסומן בנקודה עמומה.",
     group=grp_col)
i_col_pend = input.color(color.new(#9e9e9e, 25), title="צבע PCP ממתין", group=grp_col)
i_show_pcp_bars = input.bool(false, title="צבע את כל נרות ה-PCP", group=grp_col)
i_col_pcp  = input.color(color.new(#ffd54f, 80), title="גוון נרות PCP", group=grp_col)

grp_mtf    = "═══  מסגרות זמן גבוהות  ═══"
i_mtf_on   = input.bool(true, title="הצג שורת מסגרות גבוהות",
     tooltip="שורה אחת בפינה עם השבירות שחיות עכשיו ב-1H / 4H / 1D / 1W.\nמוצגות רק מסגרות גבוהות ממסגרת הגרף.",
     group=grp_mtf)
i_mtf_v    = input.string("למטה", title="גובה השורה",
     options=["למעלה", "באמצע", "למטה"], group=grp_mtf)
i_mtf_h    = input.string("שמאל", title="צד השורה",
     options=["שמאל", "מרכז", "ימין"], group=grp_mtf)
i_mtf_pad  = input.int(0, title="הרחקת השורה מהקצה (שורות)", minval=0, maxval=12,
     tooltip="מוסיף שורות ריקות בין השורה לקצה הגרף, כדי להרים אותה מעל שורה של אינדיקטור אחר שיושב באותה פינה.",
     group=grp_mtf)
i_inv_wick = input.bool(false, title="בטל שבירה לפי פתיל",
     tooltip="כבוי (ברירת מחדל): שבירה מתה כשנר של אותה מסגרת נסגר מעבר לרמת הסווינג.\nדלוק: מספיק פתיל מעבר לרמה.",
     group=grp_mtf)
i_pnl_on   = input.bool(false, title="הצג פאנל מסגרות", group=grp_mtf)
i_pnl_v    = input.string("למטה", title="גובה הפאנל",
     options=["למעלה", "באמצע", "למטה"], group=grp_mtf)
i_pnl_h    = input.string("ימין", title="צד הפאנל",
     options=["שמאל", "מרכז", "ימין"], group=grp_mtf)
i_pnl_pad  = input.int(0, title="הרחקת הפאנל מהקצה (שורות)", minval=0, maxval=12, group=grp_mtf)
i_col_neut = input.color(color.new(#ffffff, 15), title="צבע טקסט נייטרלי", group=grp_mtf)
i_mtf_alert = input.bool(true, title="התראה על שינוי בשורה", group=grp_mtf)

// ══════════════════════════════════════════════════════════════
//  TIMEFRAME GATE  (chart drawing only — the corner line is independent)
// ══════════════════════════════════════════════════════════════

tf_str = timeframe.period

is_1m  = tf_str == "1"
is_5m  = tf_str == "5"
is_15m = tf_str == "15"
is_1h  = tf_str == "60"
is_4h  = tf_str == "240"
is_1d  = tf_str == "D"
is_1w  = tf_str == "W"

tf_allowed = (is_1m  and i_tf_1m)  or
             (is_5m  and i_tf_5m)  or
             (is_15m and i_tf_15m) or
             (is_1h  and i_tf_1h)  or
             (is_4h  and i_tf_4h)  or
             (is_1d  and i_tf_1d)  or
             (is_1w  and i_tf_1w)

// ══════════════════════════════════════════════════════════════
//  CANDLE DIRECTION  (+1 Bull / -1 Bear / 0 Doji)
// ══════════════════════════════════════════════════════════════

f_dir(float o, float c) =>
    c > o ? 1 : c < o ? -1 : 0

// ══════════════════════════════════════════════════════════════
//  CHART-TIMEFRAME FETCHES
//  lookahead_off → proper backtest support for all timeframes
//  gaps_off      → no na bars when the external symbol has no tick
// ══════════════════════════════════════════════════════════════

f_sec(simple string sym) =>
    [o, h, l, c] = request.security(sym, timeframe.period,
         [open, high, low, close],
         lookahead = barmerge.lookahead_off,
         gaps      = barmerge.gaps_off)
    [o, h, l, c]

[a_nq_o, a_nq_h, a_nq_l, a_nq_c] = f_sec(i_sym_nq)
[a_es_o, a_es_h, a_es_l, a_es_c] = f_sec(i_sym_es)
[a_ym_o, a_ym_h, a_ym_l, a_ym_c] = f_sec(i_sym_ym)

nq_dir = f_dir(a_nq_o, a_nq_c)
es_dir = f_dir(a_es_o, a_es_c)
ym_dir = f_dir(a_ym_o, a_ym_c)

// ══════════════════════════════════════════════════════════════
//  PCP DETECTION
//
//  ES vs NQ : any direction mismatch is a divergence.
//  YM       : asymmetric — YM only matters when it shows STRENGTH,
//             i.e. YM closes UP while ES and/or NQ close DOWN.
//             YM down against the other two up is NOT a signal.
//  1m       : YM is excluded entirely.
// ══════════════════════════════════════════════════════════════

nq_ok = i_use_nq and (not i_ignore_doji or nq_dir != 0)
es_ok = i_use_es and (not i_ignore_doji or es_dir != 0)
ym_ok = i_use_ym and not is_1m and (not i_ignore_doji or ym_dir != 0)

div_es_nq = nq_ok and es_ok and (nq_dir != es_dir)

div_ym = ym_ok and ym_dir > 0 and
         ((es_ok and es_dir < 0) or (nq_ok and nq_dir < 0))

is_pcp = div_es_nq or div_ym

// ══════════════════════════════════════════════════════════════
//  PSP DETECTION  — 3-Bar Swing, Zero Repaint, No Flicker
//
//  Timeline:   bar[2] ←  bar[1]  ← bar[0]
//                       (SWING)    (confirms, current CLOSED bar)
//
//  The swing is checked on EVERY included asset, not only on the chart
//  symbol, so a swing that happens on NQ while the chart shows ES is
//  still marked — just with a hollow marker so it is never confused
//  with a swing on the bars in front of you.
// ══════════════════════════════════════════════════════════════

f_sw_hi(float h) => h[1] > h[2] and h[1] > h[0]
f_sw_lo(float l) => l[1] < l[2] and l[1] < l[0]

own_hi = f_sw_hi(high)
own_lo = f_sw_lo(low)

ext_hi = (i_use_nq  and f_sw_hi(a_nq_h)) or
         (i_use_es  and f_sw_hi(a_es_h)) or
         (div_ym[1] and f_sw_hi(a_ym_h))

ext_lo = (i_use_nq  and f_sw_lo(a_nq_l)) or
         (i_use_es  and f_sw_lo(a_es_l)) or
         (div_ym[1] and f_sw_lo(a_ym_l))

confirmed = barstate.isconfirmed
pcp_at_1  = is_pcp[1]          // immutable — bar[1] is fully closed

psp_base     = tf_allowed and confirmed and pcp_at_1

psp_bear_own = psp_base and own_hi
psp_bear_ext = psp_base and ext_hi and not own_hi
psp_bull_own = psp_base and own_lo
psp_bull_ext = psp_base and ext_lo and not own_lo

// ══════════════════════════════════════════════════════════════
//  PSP MARKERS
//  offset = -1 places the marker on bar[1] — the bar that was resolved.
// ══════════════════════════════════════════════════════════════

c_bear_ext = color.new(i_col_bear, i_ext_transp)
c_bull_ext = color.new(i_col_bull, i_ext_transp)

plotchar(psp_bear_own ? 1 : na, title="PSP Bear — Own Asset",
     char="▲", location=location.abovebar, color=i_col_bear,
     offset=-1, size=size.tiny)

plotchar(psp_bear_ext ? 1 : na, title="PSP Bear — Other Asset",
     char="△", location=location.abovebar, color=c_bear_ext,
     offset=-1, size=size.tiny)

plotchar(psp_bull_own ? 1 : na, title="PSP Bull — Own Asset",
     char="▼", location=location.belowbar, color=i_col_bull,
     offset=-1, size=size.tiny)

plotchar(psp_bull_ext ? 1 : na, title="PSP Bull — Other Asset",
     char="▽", location=location.belowbar, color=c_bull_ext,
     offset=-1, size=size.tiny)

// ── Pending: self-clearing, because a bar is undecided exactly while
//    barstate.isconfirmed is false. Historical bars are always confirmed.
pending = tf_allowed and i_show_pending and not confirmed

plotchar(pending and is_pcp    ? 1 : na, title="PCP Pending — Live Bar",
     char="•", location=location.abovebar, color=i_col_pend, size=size.tiny)

plotchar(pending and is_pcp[1] ? 1 : na, title="PCP Pending — Previous Bar",
     char="•", location=location.abovebar, color=i_col_pend,
     offset=-1, size=size.tiny)

barcolor(tf_allowed and i_show_pcp_bars and is_pcp ? i_col_pcp : na,
     title="PCP Bar Tint")

// ══════════════════════════════════════════════════════════════
//  HIGHER TIMEFRAMES
//
//  request.security returns RAW NUMBERS only — never a UDT and never an
//  array. Returning an object would make TradingView keep a copy per chart
//  bar per timeframe and blow the memory limit ("Memory limits exceeded",
//  which compiles cleanly and simply fails to load).
//
//  Every history offset is taken INSIDE the expression, so it is evaluated
//  in that timeframe's own context and a bar only enters the calculation
//  once it has closed. Zero repaint.
//
//  Index map in the requested timeframe's context:
//      [1] = last CLOSED bar      (confirms the swing, and carries the
//                                  close used for the "level taken" test)
//      [2] = the SWING bar
//      [3] = the bar before it
//
//  The call count is fixed in the source (4 timeframes × 3 assets = 12,
//  plus 3 for the chart timeframe) and never varies with the chart.
//
//  Limitation worth knowing: the state is built by stepping through the chart's
//  own history, so a timeframe can only be tracked as far back as the chart
//  reaches. A 1m chart holds days, not weeks, so 1W will usually be empty
//  there. View the weekly and daily rows from a 15m chart or higher.
// ══════════════════════════════════════════════════════════════

type AB
    float o2 = na
    float c2 = na
    float c1 = na
    float h1 = na
    float h2 = na
    float h3 = na
    float l1 = na
    float l2 = na
    float l3 = na

f_load(AB b, simple string sym, simple string tf) =>
    [t, o2, c2, c1, h1, h2, h3, l1, l2, l3] = request.security(sym, tf,
         [time[1], open[2], close[2], close[1],
          high[1], high[2], high[3], low[1], low[2], low[3]],
         lookahead = barmerge.lookahead_off,
         gaps      = barmerge.gaps_off)
    b.o2 := o2
    b.c2 := c2
    b.c1 := c1
    b.h1 := h1
    b.h2 := h2
    b.h3 := h3
    b.l1 := l1
    b.l2 := l2
    b.l3 := l3
    t

// One reusable object per asset per timeframe — allocated once, updated in
// place, so nothing accumulates across bars.
var AB n1h = AB.new()
var AB e1h = AB.new()
var AB y1h = AB.new()
var AB n4h = AB.new()
var AB e4h = AB.new()
var AB y4h = AB.new()
var AB n1d = AB.new()
var AB e1d = AB.new()
var AB y1d = AB.new()
var AB n1w = AB.new()
var AB e1w = AB.new()
var AB y1w = AB.new()

tn1h = f_load(n1h, i_sym_nq, "60")
te1h = f_load(e1h, i_sym_es, "60")
ty1h = f_load(y1h, i_sym_ym, "60")

tn4h = f_load(n4h, i_sym_nq, "240")
te4h = f_load(e4h, i_sym_es, "240")
ty4h = f_load(y4h, i_sym_ym, "240")

tn1d = f_load(n1d, i_sym_nq, "D")
te1d = f_load(e1d, i_sym_es, "D")
ty1d = f_load(y1d, i_sym_ym, "D")

tn1w = f_load(n1w, i_sym_nq, "W")
te1w = f_load(e1w, i_sym_es, "W")
ty1w = f_load(y1w, i_sym_ym, "W")

// The three contracts share a session, so any enabled one is the clock.
t1h = i_use_nq ? tn1h : i_use_es ? te1h : ty1h
t4h = i_use_nq ? tn4h : i_use_es ? te4h : ty4h
t1d = i_use_nq ? tn1d : i_use_es ? te1d : ty1d
t1w = i_use_nq ? tn1w : i_use_es ? te1w : ty1w

// ══════════════════════════════════════════════════════════════
//  PER-TIMEFRAME STATE
//  Lives in var on the CHART's timeline, which is where state belongs.
//  The rule against objects applies to what request.security returns.
// ══════════════════════════════════════════════════════════════

type MtfSt
    int    lastT = 0     // time of the bar already stepped — blocks a double step
    int    dir   = 0     // -1 bearish · 0 none · 1 bullish
    string src   = ""    // P = ES/NQ pair · Y = YM strength · B = both
    string who   = ""    // which assets made the swing
    int    age   = 0     // age in bars of this timeframe
    float  lNq   = na    // swing level per asset that made a swing
    float  lEs   = na
    float  lYm   = na

// Has the level been taken? Close beyond it by default, wick beyond it on request.
f_taken(float lvl, int dir, float hi, float lo, float cl) =>
    na(lvl) ? false : dir == -1 ? (i_inv_wick ? hi > lvl : cl > lvl) : (i_inv_wick ? lo < lvl : cl < lvl)

// One step per closed bar of that timeframe. Order is what produces
// "level taken OR new swing, whichever comes first": the stale break is
// retired first, then a fresh swing overwrites whatever is left.
f_step(MtfSt s, int t, AB n, AB e, AB y) =>
    if not na(t) and t != s.lastT
        s.lastT := t

        // ── 1. age, then invalidation against the bar that just closed ──
        if s.dir != 0
            s.age := s.age + 1
            tkN = f_taken(s.lNq, s.dir, n.h1, n.l1, n.c1)
            tkE = f_taken(s.lEs, s.dir, e.h1, e.l1, e.c1)
            tkY = f_taken(s.lYm, s.dir, y.h1, y.l1, y.c1)
            if tkN or tkE or tkY
                s.dir := 0
                s.age := 0
                s.src := ""
                s.who := ""
                s.lNq := na
                s.lEs := na
                s.lYm := na

        // ── 2. a new PSP on the swing bar, [2] ──
        dn  = f_dir(n.o2, n.c2)
        de  = f_dir(e.o2, e.c2)
        dy  = f_dir(y.o2, y.c2)
        okN = i_use_nq and not na(n.c2) and (not i_ignore_doji or dn != 0)
        okE = i_use_es and not na(e.c2) and (not i_ignore_doji or de != 0)
        okY = i_use_ym and not na(y.c2) and (not i_ignore_doji or dy != 0)

        divP = okN and okE and dn != de
        divY = okY and dy > 0 and ((okE and de < 0) or (okN and dn < 0))

        if divP or divY
            hiN = i_use_nq and n.h2 > n.h3 and n.h2 > n.h1
            hiE = i_use_es and e.h2 > e.h3 and e.h2 > e.h1
            hiY = divY     and y.h2 > y.h3 and y.h2 > y.h1
            loN = i_use_nq and n.l2 < n.l3 and n.l2 < n.l1
            loE = i_use_es and e.l2 < e.l3 and e.l2 < e.l1
            loY = divY     and y.l2 < y.l3 and y.l2 < y.l1

            nHi = (hiN ? 1 : 0) + (hiE ? 1 : 0) + (hiY ? 1 : 0)
            nLo = (loN ? 1 : 0) + (loE ? 1 : 0) + (loY ? 1 : 0)

            if nHi > 0 or nLo > 0
                bear = nHi >= nLo          // tie goes to the swing high
                gN   = bear ? hiN : loN
                gE   = bear ? hiE : loE
                gY   = bear ? hiY : loY

                w = ""
                if gN
                    w := w + "NQ"
                if gE
                    w := w + (w == "" ? "" : "·") + "ES"
                if gY
                    w := w + (w == "" ? "" : "·") + "YM"

                s.dir := bear ? -1 : 1
                s.age := 1
                s.src := divP and divY ? "B" : divP ? "P" : "Y"
                s.who := w
                s.lNq := gN ? (bear ? n.h2 : n.l2) : na
                s.lEs := gE ? (bear ? e.h2 : e.l2) : na
                s.lYm := gY ? (bear ? y.h2 : y.l2) : na
    s.dir

var MtfSt st1h = MtfSt.new()
var MtfSt st4h = MtfSt.new()
var MtfSt st1d = MtfSt.new()
var MtfSt st1w = MtfSt.new()

d1h = f_step(st1h, t1h, n1h, e1h, y1h)
d4h = f_step(st4h, t4h, n4h, e4h, y4h)
d1d = f_step(st1d, t1d, n1d, e1d, y1d)
d1w = f_step(st1w, t1w, n1w, e1w, y1w)

// ══════════════════════════════════════════════════════════════
//  CORNER LINE
//  Record layout:   <TF> <arrow><source> <assets> <age>
//      1W ▼P NQ·ES 8   →  weekly bearish, ES/NQ pair, both swung, 8 bars old
//  Only timeframes ABOVE the chart's are listed: the chart's own is already
//  drawn on the bars, and anything below it cannot be tracked accurately.
// ══════════════════════════════════════════════════════════════

f_rec(MtfSt s, string nm) =>
    s.dir == 0 ? "" : nm + " " + (s.dir < 0 ? "▼" : "▲") + s.src + " " + s.who + " " + str.tostring(s.age)

chartSec = timeframe.in_seconds(timeframe.period)
sh1h = timeframe.in_seconds("60")  > chartSec
sh4h = timeframe.in_seconds("240") > chartSec
sh1d = timeframe.in_seconds("D")   > chartSec
sh1w = timeframe.in_seconds("W")   > chartSec

r1w = sh1w ? f_rec(st1w, "1W") : ""
r1d = sh1d ? f_rec(st1d, "1D") : ""
r4h = sh4h ? f_rec(st4h, "4H") : ""
r1h = sh1h ? f_rec(st1h, "1H") : ""

f_join(string acc, string add) =>
    add == "" ? acc : acc == "" ? add : acc + "   " + add

mark = f_join(f_join(f_join(r1w, r1d), r4h), r1h)

// Kept as one-line statements on purpose: Pine treats a continuation line
// indented by any multiple of four spaces as the start of a block, so a
// column-aligned wrapped ternary is a syntax error waiting to happen.
mtfTop = i_mtf_h == "שמאל" ? position.top_left : i_mtf_h == "מרכז" ? position.top_center : position.top_right
mtfMid = i_mtf_h == "שמאל" ? position.middle_left : i_mtf_h == "מרכז" ? position.middle_center : position.middle_right
mtfBot = i_mtf_h == "שמאל" ? position.bottom_left : i_mtf_h == "מרכז" ? position.bottom_center : position.bottom_right
mtfPos = i_mtf_v == "למעלה" ? mtfTop : i_mtf_v == "באמצע" ? mtfMid : mtfBot

// Padding: the table is anchored to an edge, so empty spacer rows on the edge
// side push the content away from it. Anchored at the top the spacers go
// above the content, otherwise below it.
mtfUp  = i_mtf_v == "למעלה"
mtfRow = mtfUp ? i_mtf_pad : 0

// Five columns, not one joined string: a cell carries a single text colour,
// and each timeframe has to be painted in its own direction's colour.
var table mtfTbl = table.new(mtfPos, 5, 1 + i_mtf_pad, border_width = 0)

c_clear = color.new(color.black, 100)

if barstate.islast and i_mtf_on
    if i_mtf_pad > 0
        for k = 0 to i_mtf_pad - 1
            table.cell(mtfTbl, 0, mtfUp ? k : 1 + k, " ",
                 text_size = size.small, bgcolor = c_clear)

    table.cell(mtfTbl, 0, mtfRow, mark == "" ? "" : "ADI", text_color = i_col_neut,
         text_size = size.small, bgcolor = c_clear)

    col = 1
    if r1w != ""
        table.cell(mtfTbl, col, mtfRow, r1w, text_color = d1w < 0 ? i_col_bear : i_col_bull,
             text_size = size.small, bgcolor = c_clear)
        col := col + 1
    if r1d != ""
        table.cell(mtfTbl, col, mtfRow, r1d, text_color = d1d < 0 ? i_col_bear : i_col_bull,
             text_size = size.small, bgcolor = c_clear)
        col := col + 1
    if r4h != ""
        table.cell(mtfTbl, col, mtfRow, r4h, text_color = d4h < 0 ? i_col_bear : i_col_bull,
             text_size = size.small, bgcolor = c_clear)
        col := col + 1
    if r1h != ""
        table.cell(mtfTbl, col, mtfRow, r1h, text_color = d1h < 0 ? i_col_bear : i_col_bull,
             text_size = size.small, bgcolor = c_clear)
        col := col + 1
    if col <= 4
        for k = col to 4
            table.cell(mtfTbl, k, mtfRow, "", bgcolor = c_clear)

// ══════════════════════════════════════════════════════════════
//  PANEL  (optional, off by default)
// ══════════════════════════════════════════════════════════════

pnlTop = i_pnl_h == "שמאל" ? position.top_left : i_pnl_h == "מרכז" ? position.top_center : position.top_right
pnlMid = i_pnl_h == "שמאל" ? position.middle_left : i_pnl_h == "מרכז" ? position.middle_center : position.middle_right
pnlBot = i_pnl_h == "שמאל" ? position.bottom_left : i_pnl_h == "מרכז" ? position.bottom_center : position.bottom_right
pnlPos = i_pnl_v == "למעלה" ? pnlTop : i_pnl_v == "באמצע" ? pnlMid : pnlBot

pnlUp  = i_pnl_v == "למעלה"
pnlR0  = pnlUp ? i_pnl_pad : 0

var table pnlTbl = table.new(pnlPos, 2, 5 + i_pnl_pad, border_width = 0)

// "▶" marks a timeframe at or below the chart's: that one is drawn on the bars
// themselves rather than tracked here.
f_stat(MtfSt s, bool shown) =>
    not shown ? "▶" : s.dir == 0 ? "—" : (s.dir < 0 ? "▼" : "▲") + s.src + " " + s.who + " " + str.tostring(s.age)

f_statCol(int dir, bool shown) =>
    not shown or dir == 0 ? i_col_neut : dir < 0 ? i_col_bear : i_col_bull

if barstate.islast and i_pnl_on
    if i_pnl_pad > 0
        for k = 0 to i_pnl_pad - 1
            table.cell(pnlTbl, 0, pnlUp ? k : 5 + k, " ",
                 text_size = size.small, bgcolor = c_clear)

    table.cell(pnlTbl, 0, pnlR0, "ADI", text_color = i_col_neut, text_size = size.small, bgcolor = c_clear)
    table.cell(pnlTbl, 1, pnlR0, "",    text_color = i_col_neut, text_size = size.small, bgcolor = c_clear)
    table.cell(pnlTbl, 0, pnlR0 + 1, "1W", text_color = f_statCol(d1w, sh1w), text_size = size.small, bgcolor = c_clear)
    table.cell(pnlTbl, 1, pnlR0 + 1, f_stat(st1w, sh1w), text_color = f_statCol(d1w, sh1w), text_size = size.small, bgcolor = c_clear)
    table.cell(pnlTbl, 0, pnlR0 + 2, "1D", text_color = f_statCol(d1d, sh1d), text_size = size.small, bgcolor = c_clear)
    table.cell(pnlTbl, 1, pnlR0 + 2, f_stat(st1d, sh1d), text_color = f_statCol(d1d, sh1d), text_size = size.small, bgcolor = c_clear)
    table.cell(pnlTbl, 0, pnlR0 + 3, "4H", text_color = f_statCol(d4h, sh4h), text_size = size.small, bgcolor = c_clear)
    table.cell(pnlTbl, 1, pnlR0 + 3, f_stat(st4h, sh4h), text_color = f_statCol(d4h, sh4h), text_size = size.small, bgcolor = c_clear)
    table.cell(pnlTbl, 0, pnlR0 + 4, "1H", text_color = f_statCol(d1h, sh1h), text_size = size.small, bgcolor = c_clear)
    table.cell(pnlTbl, 1, pnlR0 + 4, f_stat(st1h, sh1h), text_color = f_statCol(d1h, sh1h), text_size = size.small, bgcolor = c_clear)

// ══════════════════════════════════════════════════════════════
//  ALERT
//  One alert covers every timeframe. It fires on any change to the line —
//  a new break, a replaced one, or an invalidation. Alerts run on
//  TradingView's servers, so a single alert placed on one chart keeps
//  working with the chart closed.
// ══════════════════════════════════════════════════════════════

var string mtfPrev = ""
if i_mtf_alert and i_mtf_on and mark != mtfPrev and mark != ""
    alert("ADI: " + mark, alert.freq_once_per_bar)
mtfPrev := mark

// ══════════════════════════════════════════════════════════════
//  END OF SCRIPT
// ══════════════════════════════════════════════════════════════
